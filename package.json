{
  "name": "jk-anime-streamflix-bot",
  "version": "1.0.0",
  "description": "Bot interactivo para cargar series de JK Anime en la base de datos StreamFlix",
  "bin": "import_series_to_streamflix.js",
  "main": "import_series_to_streamflix.js",
  "scripts": {
    "build:win": "pkg . --public --public-packages '*' --targets node16-win-x64 --output jk-anime-streamflix-bot.exe",
    "build:mac:arm64": "pkg . --public --public-packages '*' --targets node16-macos-arm64 --output jk-anime-streamflix-bot-macos-arm64",
    "build:mac:x64": "pkg . --public --public-packages '*' --targets node16-macos-x64 --output jk-anime-streamflix-bot-macos-x64"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "dotenv": "^16.4.5",
    "mssql": "^9.1.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "README.md",
      "import_series_to_streamflix.js",
      "save_episode_url_to_streamflix.js",
      "save_pelisplus_to_streamflix.js"
    ]
  }
}
